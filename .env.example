# ==============================================================================
# SIH26108 STANDARDS RECOMMENDATION ENGINE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. STANDARDS DATA REPOSITORY & VECTOR BACKEND TARGETS
# ------------------------------------------------------------------------------
# Development Defaults (Local Baseline):
#   REPOSITORY_TYPE=json
#   VECTOR_BACKEND=faiss
# Production Target (Docker / PostgreSQL + pgvector):
#   REPOSITORY_TYPE=postgres
#   VECTOR_BACKEND=pgvector
REPOSITORY_TYPE=json
VECTOR_BACKEND=faiss

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE CONFIGURATION (Backend Only - Keep Secret)
# ------------------------------------------------------------------------------
# Connection string format: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/sih26108_standards
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_ECHO=false
DB_AUTO_CREATE_TABLES=false

# ------------------------------------------------------------------------------
# 3. DENSE EMBEDDING RETRIEVAL CONFIGURATION (Backend Only)
# ------------------------------------------------------------------------------
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384

# ------------------------------------------------------------------------------
# 4. CROSS-ENCODER RERANKING CONFIGURATION (Backend Only)
# ------------------------------------------------------------------------------
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_COUNT=10
RERANK_ENABLED=true
RERANK_WEIGHT_BETA=0.5

# ------------------------------------------------------------------------------
# 5. SERVER RUNTIME & ENVIRONMENT (Backend Only)
# ------------------------------------------------------------------------------
# PORT is dynamically assigned by cloud providers such as Render
PORT=8000
RUN_POSTGRES_TESTS=false

# ------------------------------------------------------------------------------
# 6. FRONTEND PUBLIC API CONFIGURATION (Exposed to Browser via Vite)
# ------------------------------------------------------------------------------
# For local dev / Docker Compose proxy, use '/api'
# For Render deployment, set to 'https://your-backend-name.onrender.com/api'
VITE_API_BASE_URL=/api
